APP_NAME="Libya Passport Reader"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

PASSPORT_API_RATE_LIMIT=60
PASSPORT_MAX_UPLOAD_KB=30720
PASSPORT_TEMP_DIRECTORY=app/private/passport-tmp
PASSPORT_OCR_ENGINE=tesseract
PASSPORT_TESSERACT_BINARY=tesseract
PASSPORT_OCR_LANGUAGE=eng
PASSPORT_OCR_PSM=6
PASSPORT_OCR_TIMEOUT=20
PASSPORT_VISION_ENABLED=true
PASSPORT_VISION_PYTHON_BINARY=python3
PASSPORT_VISION_TIMEOUT=12
PASSPORT_VISION_MAX_DIMENSION=1400
PASSPORT_VISION_MIN_DOCUMENT_AREA=0.20
PASSPORT_VISION_BLUR_WARNING=75
PASSPORT_VISION_BLUR_REJECT=35
PASSPORT_VISION_GLARE_WARNING=0.18
PASSPORT_VISION_GLARE_REJECT=0.35
PASSPORT_VISION_REJECT_LOW_QUALITY=true
PASSPORT_SMART_SCANNER_ENABLED=true
PASSPORT_IMAGEMAGICK_BINARY=magick
PASSPORT_SMART_SCANNER_TIMEOUT=15
PASSPORT_SMART_SCANNER_MAX_DIMENSION=2600
PASSPORT_SMART_SCANNER_DESKEW=40%
PASSPORT_SMART_SCANNER_CONTRAST=1%x1%
PASSPORT_SMART_SCANNER_MRZ_START=0.62
PASSPORT_SMART_SCANNER_MRZ_CANDIDATES=0.54,0.60,0.66
PASSPORT_SMART_SCANNER_MAX_MRZ_CANDIDATES=4
PASSPORT_SMART_SCANNER_VISUAL_END=0.78
PASSPORT_VISUAL_ZONE_ENABLED=true
PASSPORT_VISUAL_OCR_LANGUAGE=eng+ara
PASSPORT_VISUAL_OCR_FALLBACK_LANGUAGE=eng
PASSPORT_VISUAL_OCR_PSM=6
PASSPORT_VISUAL_OCR_TIMEOUT=20
PASSPORT_PDFTOPPM_BINARY=pdftoppm
PASSPORT_PDF_DPI=300
