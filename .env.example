APP_NAME="Libya Passport Reader"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

PASSPORT_API_RATE_LIMIT=60
PASSPORT_MAX_UPLOAD_KB=10240
PASSPORT_TEMP_DIRECTORY=app/private/passport-tmp
PASSPORT_OCR_ENGINE=tesseract
PASSPORT_TESSERACT_BINARY=tesseract
PASSPORT_OCR_LANGUAGE=eng
PASSPORT_OCR_PSM=6
PASSPORT_OCR_TIMEOUT=20
PASSPORT_PDFTOPPM_BINARY=pdftoppm
PASSPORT_PDF_DPI=300
